{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OverprivilegedBedrockAgent",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:CreateAgent",
        "bedrock:DeleteAgent",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*"
    }
  ]
}
